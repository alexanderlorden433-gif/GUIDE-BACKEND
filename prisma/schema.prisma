// The Guide — database schema
// Run `npx prisma migrate dev --name init` locally to create your first migration,
// or `npx prisma migrate deploy` in production once DATABASE_URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String

  // Billing
  isPro                Boolean  @default(false)
  planType             String?  // "monthly" | "lifetime" | null
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique

  // Referrals: everyone gets a unique shareable code at signup. If they
  // signed up via someone else's link, referredByCode stores that code.
  // bonusProUntil is a free-Pro grant earned from referrals going Pro --
  // separate from real billing, and simply expires on its own.
  referralCode         String?  @unique
  referredByCode       String?
  bonusProUntil        DateTime?

  // App data — mirrors the single JSON blob the frontend already builds
  // (completed, tools, niches, streak, bookmarks, lastVisited, hasSeenTour)
  dataBlob             Json     @default("{}")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  passwordResets       PasswordReset[]
  mentorProfiles       MentorProfile[]
  notifications        Notification[]
  discussionPosts      DiscussionPost[]
  wins                 Win[]
  winReactions         WinReaction[]
  networkRequests      NetworkRequest[]   @relation("NetworkFrom")
  networkReceived      NetworkRequest[]   @relation("NetworkTo")

  @@index([stripeCustomerId])
  @@index([referredByCode])
}

// Per-chapter discussion — a lightweight forum. Top-level posts
// (parentId null) plus one level of replies underneath each; no deeper
// nesting, which keeps both the UI and the moderation surface simple.
model DiscussionPost {
  id        String   @id @default(uuid())
  nicheId   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  parentId  String?
  parent    DiscussionPost?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DiscussionPost[] @relation("Replies")
  createdAt DateTime @default(now())

  @@index([nicheId, parentId, createdAt])
  @@index([parentId])
}

// In-app notification feed -- referral activity, new partners, new mentors
// in a chapter you follow. Separate from the email reminders (digest.js,
// streakReminder.js), which are their own thing.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "referral_signup" | "referral_bonus" | "new_partner" | "new_mentor"
  title     String
  body      String
  link      Json?    // e.g. {"view":"invite"} or {"view":"niche","nicheId":"video","tab":"mentors"}
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Mentor Directory: opt-in profiles, one per user per chapter, visible to
// every signed-in user browsing that chapter — not just the person who made it.
model MentorProfile {
  id          String   @id @default(uuid())
  nicheId     String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  displayName String
  bio         String
  lookingFor  Json     // array of strings, e.g. ["mentor", "network"]
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([nicheId, authorId])
  @@index([nicheId])
}

// Real password reset tokens (replacing the prototype's "just tell us your email" flow).
// A token is emailed to the user; they submit it + a new password to /api/auth/reset-password.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Business partners / sponsors of The Guide itself -- curated by the owner,
// visible to every signed-in user. Not user-generated content (unlike
// MentorProfile), so there's no authorId here at all.
model Partner {
  id          String   @id @default(uuid())
  name        String
  description String
  websiteUrl  String?
  emoji       String   @default("🤝")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// Pre-launch email waitlist -- public signup, no account required. Used to
// collect interested emails before the app opens up, then email everyone
// once via the owner-only /launch-announcement endpoint.
model WaitlistSignup {
  id         String   @id @default(uuid())
  email      String   @unique
  niche      String?
  notifiedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Client-facing project status pages (Lifetime perk). The owner (a User)
// creates/updates one of these per client; the public reads it at
// /client-status.html?t=<token> with no login -- it's meant to be sent as a
// link. Intentionally has no relation back to a User model field so a
// public GET by token never has to touch or expose account data beyond the
// owner's display name, which we deliberately don't even store here.
model ClientStatusPage {
  id          String   @id @default(uuid())
  token       String   @unique
  ownerId     String
  clientName  String
  projectName String
  status      String   @default("In Progress")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

// ---------- Wins Board ----------
// Public celebrations -- a user posts a win (text + optional emoji category),
// other users react with emoji. Lightweight social proof that keeps people
// coming back and seeing each other succeed.
model Win {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  emoji     String   @default("🎉")
  reactions WinReaction[]
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([authorId])
}

model WinReaction {
  id     String @id @default(uuid())
  winId  String
  win    Win    @relation(fields: [winId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji  String // "🔥", "👏", "💪", "❤️"

  @@unique([winId, userId, emoji])
  @@index([winId])
}

// ---------- Networking / Connect ----------
// One user sends a connection request to another; the other user sees it
// in their network tab. No messaging yet — just the intent to connect,
// with both users' profiles visible to each other once accepted.
model NetworkRequest {
  id         String   @id @default(uuid())
  fromUserId String
  fromUser   User     @relation("NetworkFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("NetworkTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // "pending" | "accepted" | "declined"
  nicheId    String?  // which niche they connected through
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId])
}

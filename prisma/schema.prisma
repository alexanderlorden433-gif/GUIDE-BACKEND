// The Guide — database schema
// Run `npx prisma migrate dev --name init` locally to create your first migration,
// or `npx prisma migrate deploy` in production once DATABASE_URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  passwordHash         String

  // Billing
  isPro                Boolean  @default(false)
  planType             String?  // "monthly" | "lifetime" | null
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique

  // Referrals: everyone gets a unique shareable code at signup. If they
  // signed up via someone else's link, referredByCode stores that code.
  // bonusProUntil is a free-Pro grant earned from referrals going Pro --
  // separate from real billing, and simply expires on its own.
  referralCode         String?  @unique
  referredByCode       String?
  bonusProUntil        DateTime?

  // App data — mirrors the single JSON blob the frontend already builds
  // (completed, tools, niches, streak, bookmarks, lastVisited, hasSeenTour)
  dataBlob             Json     @default("{}")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  passwordResets       PasswordReset[]
  mentorProfiles       MentorProfile[]
  notifications        Notification[]
  discussionPosts      DiscussionPost[]
  wins                 Win[]
  winReactions         WinReaction[]
  networkRequests      NetworkRequest[]   @relation("NetworkFrom")
  networkReceived      NetworkRequest[]   @relation("NetworkTo")
  liveRsvps            LiveRsvp[]
  pushSubscriptions    PushSubscription[]
  liveQuestions        LiveQuestion[]
  promoRedemptions     PromoRedemption[]
  memberSite           MemberSite?
  siteAiUses           SiteAiUse[]

  @@index([stripeCustomerId])
  @@index([referredByCode])
}

// Per-chapter discussion — a lightweight forum. Top-level posts
// (parentId null) plus one level of replies underneath each; no deeper
// nesting, which keeps both the UI and the moderation surface simple.
model DiscussionPost {
  id        String   @id @default(uuid())
  nicheId   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  parentId  String?
  parent    DiscussionPost?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DiscussionPost[] @relation("Replies")
  createdAt DateTime @default(now())

  @@index([nicheId, parentId, createdAt])
  @@index([parentId])
}

// In-app notification feed -- referral activity, new partners, new mentors
// in a chapter you follow. Separate from the email reminders (digest.js,
// streakReminder.js), which are their own thing.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "referral_signup" | "referral_bonus" | "new_partner" | "new_mentor"
  title     String
  body      String
  link      Json?    // e.g. {"view":"invite"} or {"view":"niche","nicheId":"video","tab":"mentors"}
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Mentor Directory: opt-in profiles, one per user per chapter, visible to
// every signed-in user browsing that chapter — not just the person who made it.
model MentorProfile {
  id          String   @id @default(uuid())
  nicheId     String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  displayName String
  bio         String
  lookingFor  Json     // array of strings, e.g. ["mentor", "network"]
  contact     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([nicheId, authorId])
  @@index([nicheId])
}

// Real password reset tokens (replacing the prototype's "just tell us your email" flow).
// A token is emailed to the user; they submit it + a new password to /api/auth/reset-password.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Business partners / sponsors of The Guide itself -- curated by the owner,
// visible to every signed-in user. Not user-generated content (unlike
// MentorProfile), so there's no authorId here at all.
model Partner {
  id          String   @id @default(uuid())
  name        String
  description String
  websiteUrl  String?
  emoji       String   @default("🤝")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// Pre-launch email waitlist -- public signup, no account required. Used to
// collect interested emails before the app opens up, then email everyone
// once via the owner-only /launch-announcement endpoint.
model WaitlistSignup {
  id         String   @id @default(uuid())
  email      String   @unique
  niche      String?
  notifiedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Client-facing project status pages (Lifetime perk). The owner (a User)
// creates/updates one of these per client; the public reads it at
// /client-status.html?t=<token> with no login -- it's meant to be sent as a
// link. Intentionally has no relation back to a User model field so a
// public GET by token never has to touch or expose account data beyond the
// owner's display name, which we deliberately don't even store here.
model ClientStatusPage {
  id          String   @id @default(uuid())
  token       String   @unique
  ownerId     String
  clientName  String
  projectName String
  status      String   @default("In Progress")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

// ---------- Wins Board ----------
// Public celebrations -- a user posts a win (text + optional emoji category),
// other users react with emoji. Lightweight social proof that keeps people
// coming back and seeing each other succeed.
model Win {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  emoji     String   @default("🎉")
  reactions WinReaction[]
  publicOffer WinPublic?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([authorId])
}

model WinReaction {
  id     String @id @default(uuid())
  winId  String
  win    Win    @relation(fields: [winId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji  String // "🔥", "👏", "💪", "❤️"

  @@unique([winId, userId, emoji])
  @@index([winId])
}

// ---------- Networking / Connect ----------
// One user sends a connection request to another; the other user sees it
// in their network tab. No messaging yet — just the intent to connect,
// with both users' profiles visible to each other once accepted.
model NetworkRequest {
  id         String   @id @default(uuid())
  fromUserId String
  fromUser   User     @relation("NetworkFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("NetworkTo", fields: [toUserId], references: [id], onDelete: Cascade)
  status     String   @default("pending") // "pending" | "accepted" | "declined"
  nicheId    String?  // which niche they connected through
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId])
}

// ---------- Analytics (owner + marketing dashboards) ----------
// These two tables are also created automatically when the server starts
// (see src/analytics.js), so they exist even if the schema isn't pushed.
// The app reads/writes them with SQL aggregates rather than these models.

// One row per page view / funnel step / money event. Each row carries the
// traffic source of the visit it belongs to (Google Ads, Instagram, ...).
model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String   // "pageview" | "visit" | "paywall" | "checkout" | "signup" | "purchase" | "renewal" | "cancel"
  visitorId String
  sessionId String
  userId    String?
  path      String?
  channel   String   // "Paid Search" | "Paid Social" | "Organic Search" | "Organic Social" | ...
  source    String   // "Google Ads", "Instagram", "news.ycombinator.com", ...
  medium    String?
  campaign  String?
  term      String?
  content   String?
  clickId   String?  // which ad click ID was present, e.g. "gclid"
  referrer  String?  // referring host only
  landing   String?
  device    String?
  browser   String?
  os        String?
  country   String?
  value     Float?   // money events, in dollars
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([channel, createdAt])
  @@index([userId])
}

// Where each user came from: first touch (what originally found them) plus
// the last touch before they signed up.
model UserAttribution {
  id           String    @id @default(uuid())
  userId       String    @unique
  channel      String
  source       String
  medium       String?
  campaign     String?
  term         String?
  content      String?
  clickId      String?
  referrer     String?
  landing      String?
  device       String?
  country      String?
  firstSeenAt  DateTime?
  lastChannel  String?
  lastSource   String?
  lastCampaign String?
  createdAt    DateTime  @default(now())

  @@index([channel])
  @@index([createdAt])
}

// Browser IDs (_fbp/_fbc) and ad-measurement consent per user, so purchases
// reported from the Stripe webhook can be matched to the Meta ad that brought
// the user in. Created at startup by src/meta.js; only used when the Meta
// Conversions API is configured.
model AdMatch {
  userId    String   @id
  fbp       String?
  fbc       String?
  consent   Boolean  @default(false)
  ua        String?
  ip        String?
  updatedAt DateTime @default(now())
}

// ---------- Live calls (scheduled group calls with the community) ----------
// These three tables are also created automatically when the server starts
// (see src/live.js), so they exist even if the schema isn't pushed.
// The app reads/writes them with SQL rather than these models.

// Experts the owner has approved to schedule calls (the owner can always host).
model LiveHost {
  email    String   @id
  name     String
  headline String?
  addedAt  DateTime @default(now())
}

// One scheduled call. Times are UTC. The call link is only given to Pro members.
model LiveCall {
  id          String    @id @default(uuid())
  title       String
  description String?
  nicheId     String?
  hostEmail   String
  hostName    String
  startsAt    DateTime
  durationMin Int       @default(45)
  joinUrl     String
  status      String    @default("scheduled") // "scheduled" | "cancelled"
  remindedAt  DateTime?
  replayUrl   String?   // added by the host after the call; Pro members get "Watch replay"
  createdAt   DateTime  @default(now())
  rsvps       LiveRsvp[]
  questions   LiveQuestion[]

  @@index([startsAt])
}

// "Remind me" -- who said they will come to a call.
model LiveRsvp {
  callId    String
  userId    String
  createdAt DateTime @default(now())
  call      LiveCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
}

// A phone or browser a member turned push notifications on for (see src/push.js).
// Created at startup; only live-call notifications are pushed today.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// A question a Pro member sends in before a call, for the host to answer live.
model LiveQuestion {
  id        String   @id @default(uuid())
  callId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  call      LiveCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([callId])
}

// Partner codes (src/routes/codes.js): a code worth N free Pro days, given out by a partner.
// Created at startup with CREATE TABLE IF NOT EXISTS; declared here so the schema matches.
model PromoCode {
  id        String   @id
  code      String   @unique
  label     String
  days      Int
  maxUses   Int?
  uses      Int      @default(0)
  active    Boolean  @default(true)
  expiresAt DateTime?
  commissionPct Int?
  createdAt DateTime @default(now())
  redemptions PromoRedemption[]
  payouts   PartnerPayout[]
}

// Creator payouts: what was paid to a code's partner for a month (src/routes/codes.js).
model PartnerPayout {
  id     String    @id
  codeId String
  month  String
  amount Float
  paidAt DateTime  @default(now())
  code   PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  @@unique([codeId, month])
}

model PromoRedemption {
  id        String   @id
  codeId    String
  userId    String
  createdAt DateTime @default(now())
  code      PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([codeId, userId])
}

// The free 7-day email course (src/leads.js): people who left their email on the landing page.
// Created at startup with CREATE TABLE IF NOT EXISTS; declared here so the schema matches.
model Lead {
  id             String    @id
  email          String    @unique
  source         String?
  token          String    @unique
  day            Int       @default(0)
  lastSentAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// ---------- Member websites ----------
// A member's one-page site at theguide.company/s/<slug> (src/sites.js). Created at startup with
// CREATE TABLE IF NOT EXISTS; declared here so Prisma knows about them.
model MemberSite {
  id         String        @id @default(uuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug       String        @unique
  previewKey String
  data       Json          @default("{}")
  published  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now())
  requests   SiteRequest[]
}

// A request a visitor sent through a member's site.
model SiteRequest {
  id        String     @id @default(uuid())
  siteId    String
  site      MemberSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  contact   String
  service   String?
  message   String?
  seen      Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([siteId, createdAt])
}

// How many times a member used the AI page writer on a day (src/siteAi.js), for the daily limit.
model SiteAiUse {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  n      Int    @default(0)

  @@id([userId, day])
}

// Wins a member offered for the public landing page (src/routes/publicWins.js). Shown only once
// the owner approves. Created at startup with CREATE TABLE IF NOT EXISTS; declared here so the schema matches.
model WinPublic {
  winId      String    @id
  status     String    @default("waiting")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  win        Win       @relation(fields: [winId], references: [id], onDelete: Cascade)
  @@index([status])
}

// Billing emails (src/billingEmails.js): which one-time emails went out (trial ending, checkout left).
// Created at startup with CREATE TABLE IF NOT EXISTS; declared here so the schema matches.
model EmailSent {
  id     String   @id
  kind   String
  ref    String
  userId String?
  sentAt DateTime @default(now())
  @@unique([kind, ref])
}

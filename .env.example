# --- Database ---
# Postgres connection string. Most hosts (Railway, Render, Supabase, Neon) give you this directly.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys — use test keys (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY="sk_test_..."
# From https://dashboard.stripe.com/webhooks after you create the webhook endpoint (see README).
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create these as Products/Prices in the Stripe dashboard first, then paste their Price IDs here.
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_LIFETIME="price_..."

# --- App URLs ---
# Where Stripe should send the user back after checkout, and what origin to allow for CORS.
APP_URL="http://localhost:5173"
PORT=4000

# --- Email alerts (mentor applications) ---
# From https://resend.com/api-keys — free tier is generous, no credit card needed to start.
RESEND_API_KEY="re_..."
# The "from" address for outgoing alert emails. Use Resend's default onboarding
# address (onboarding@resend.dev) until you've verified your own domain in Resend.
EMAIL_FROM="onboarding@resend.dev"
# Where new-mentor-application alerts get sent. This can be any inbox you check.
ADMIN_ALERT_EMAIL="you@example.com"

{"id":"creator/6fd334e5","th":"c73d582a","dur":22.94,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":5.113,"sents":[{"t0":0.35,"t1":5.113,"d":"Take social media breaks for your own mental health, not just for content strategy.","w":[0.374,0.65,1.037,1.479,1.866,2.087,2.253,2.474,2.861,3.138,3.414,3.746,3.967,4.465],"p":[[7,"🧘","Mental health breaks","key"]]}],"ic":"📱"},{"kind":"tip","label":"why","heading":null,"t0":5.733,"t1":12.708,"sents":[{"t0":5.733,"t1":12.708,"d":"Constant posting, comments and comparison wear you down, and burnout can stop you for far longer than a planned break.","w":[5.757,6.379,6.877,7.437,7.624,8.308,8.557,8.743,9.054,9.241,9.739,9.987,10.361,10.547,10.796,11.107,11.48,11.667,11.854,12.227],"p":[[9,"🔥","Burnout lasts longer","key"]]}],"ic":"📱"},{"kind":"tip","label":"how","heading":null,"t0":13.328,"t1":22.39,"sents":[{"t0":13.328,"t1":17.735,"d":"Schedule one offline day each week and turn off notifications during it.","w":[13.362,13.902,14.142,14.563,14.803,15.103,15.403,15.584,15.884,16.064,17.025,17.445],"p":[[2,"📴","Offline day weekly","do"]]},{"t0":17.975,"t1":22.39,"d":"If you feel drained for weeks, take longer time off and talk to someone you trust.","w":[17.998,18.117,18.294,18.59,19.003,19.24,19.595,19.89,20.245,20.541,20.718,20.895,21.191,21.368,21.782,21.96]}],"ic":"🗓️"}]}
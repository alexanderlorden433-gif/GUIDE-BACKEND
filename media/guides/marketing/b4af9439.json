{"id":"marketing/b4af9439","th":"3984ca45","dur":21.703,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.354,"sents":[{"t0":0.35,"t1":4.354,"d":"Use urgency sparingly — overusing it trains people to ignore it.","w":[0.373,0.661,1.179,1.697,1.87,2.561,2.676,3.08,3.483,3.655,4.058],"p":[[2,"⏳","Use urgency sparingly","key"]]}],"ic":"📈"},{"kind":"tip","label":"why","heading":null,"t0":4.974,"t1":11.423,"sents":[{"t0":4.974,"t1":11.423,"d":"Fake or constant deadlines damage trust, and once people catch one, they doubt every offer you make after it.","w":[5.08,5.401,5.593,6.235,6.812,7.261,7.645,7.838,8.158,8.607,8.928,9.184,9.377,9.697,10.018,10.275,10.467,10.788,11.108],"p":[[5,"💔","Deadlines damage trust","no"]]}],"ic":"🗓️"},{"kind":"tip","label":"how","heading":null,"t0":12.043,"t1":21.153,"sents":[{"t0":12.043,"t1":18.438,"d":"Save deadlines for real limits, like a launch window or limited spots, and use them a few times a year.","w":[12.08,12.38,12.92,13.161,13.521,13.941,14.242,14.422,14.842,15.263,15.443,15.923,16.344,16.524,16.824,17.064,17.244,17.545,17.905,18.085]},{"t0":18.678,"t1":21.153,"d":"Always honor the deadline once you announce it.","w":[18.698,19.173,19.469,19.587,20.061,20.358,20.536,20.95],"p":[[1,"✅","Honor every deadline","do"]]}],"ic":"🚧"}]}
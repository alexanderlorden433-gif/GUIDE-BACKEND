{"id":"writing/caf1bd30","th":"9b014ca1","dur":21.541,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":3.904,"sents":[{"t0":0.35,"t1":3.904,"d":"Cut every sentence that doesn't move the reader toward the next one.","w":[0.371,0.597,0.879,1.331,1.557,1.952,2.235,2.348,2.686,3.138,3.251,3.59],"p":[[7,"✂️","Keep readers moving","key"]]}],"ic":"✍️"},{"kind":"tip","label":"why","heading":null,"t0":4.524,"t1":10.706,"sents":[{"t0":4.524,"t1":10.706,"d":"Every extra line is another chance for a reader to drift off before they reach your point or call to action.","w":[4.546,4.857,5.291,5.601,5.725,6.098,6.47,6.718,6.904,7.276,7.462,7.835,8.021,8.455,8.641,9.014,9.2,9.572,9.758,10.068,10.254],"p":[[10,"💤","Readers drift off","no"]]}],"ic":"✍️"},{"kind":"tip","label":"how","heading":null,"t0":11.326,"t1":20.991,"sents":[{"t0":11.326,"t1":15.204,"d":"During your edit, test each sentence by reading the paragraph without it.","w":[11.348,11.754,11.928,12.218,12.508,12.798,13.261,13.493,13.899,14.015,14.595,15.001],"p":[[3,"🧪","Test by deleting","do"]]},{"t0":15.444,"t1":20.991,"d":"If nothing important is lost, cut it, starting with warm-up openers and repeated recaps.","w":[15.466,15.6,16.004,16.743,16.877,17.213,17.482,17.617,18.222,18.423,19.028,19.633,19.835,20.44]}],"ic":"🎬"}]}
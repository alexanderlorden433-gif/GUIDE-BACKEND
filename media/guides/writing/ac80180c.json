{"id":"writing/ac80180c","th":"aa71c35f","dur":22.549,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.715,"sents":[{"t0":0.35,"t1":4.715,"d":"Avoid working from verbal briefs alone — always confirm scope in writing.","w":[0.371,0.724,1.136,1.371,1.782,2.194,2.546,2.723,3.193,3.663,4.016,4.192],"p":[[11,"✍️","Scope in writing","key"]]}],"ic":"🚧"},{"kind":"tip","label":"why","heading":null,"t0":5.335,"t1":12.162,"sents":[{"t0":5.335,"t1":12.162,"d":"People remember calls differently, and without a written record, a disagreement about scope becomes your word against theirs.","w":[5.355,5.779,6.263,6.627,7.233,7.415,7.839,8.02,8.323,8.687,8.869,9.717,10.08,10.444,10.868,11.05,11.353,11.777],"p":[[3,"🗣️","Memories differ","key"]]}],"ic":"🚧"},{"kind":"tip","label":"how","heading":null,"t0":12.782,"t1":21.999,"sents":[{"t0":12.782,"t1":18.081,"d":"Right after any call, email a short recap of the deliverables, deadline and key points.","w":[12.809,13.134,13.459,13.719,14.045,14.5,14.695,15.085,15.476,15.606,15.736,16.582,17.102,17.297,17.557],"p":[[7,"📧","Email a recap","do"]]},{"t0":18.32,"t1":21.999,"d":"Ask the client to reply confirming it before you start the draft.","w":[18.346,18.581,18.698,19.167,19.343,19.753,20.339,20.456,20.866,21.042,21.452,21.569]}],"ic":"✉️"}]}
{"id":"writing/89f0db2d","th":"4896bac3","dur":20.584,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.638,"sents":[{"t0":0.35,"t1":4.638,"d":"Don't send a first draft without reading it fresh the next day if time allows.","w":[0.37,0.718,1.009,1.183,1.531,1.88,2.286,2.692,2.808,3.099,3.215,3.563,3.795,3.912,4.202],"p":[[8,"🌅","Read it fresh","key"]]}],"ic":"🗓️"},{"kind":"tip","label":"why","heading":null,"t0":5.258,"t1":12.336,"sents":[{"t0":5.258,"t1":12.336,"d":"After hours with a draft, your brain fills in missing words and skips clumsy lines that a client will spot instantly.","w":[5.279,5.602,5.924,6.117,6.311,6.697,6.891,7.278,7.6,7.793,8.18,8.567,8.76,9.147,9.599,9.985,10.243,10.437,10.952,11.21,11.597],"p":[[12,"🧠","Brain skips errors","no"]]}],"ic":"🗓️"},{"kind":"tip","label":"how","heading":null,"t0":12.956,"t1":20.034,"sents":[{"t0":12.956,"t1":15.413,"d":"Plan to finish each draft a day before it's due.","w":[12.985,13.238,13.39,13.694,13.947,14.251,14.403,14.605,14.96,15.112]},{"t0":15.653,"t1":20.034,"d":"The next morning, read it once for flow and once for typos before you send it.","w":[15.689,15.804,16.149,16.609,16.896,17.011,17.299,17.529,17.816,17.989,18.276,18.506,18.966,19.368,19.541,19.828],"p":[[11,"🔍","Flow then typos","do"]]}],"ic":"💡"}]}
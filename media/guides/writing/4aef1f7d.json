{"id":"writing/4aef1f7d","th":"2c9ca9e4","dur":23.327,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":5.184,"sents":[{"t0":0.35,"t1":5.184,"d":"Ask specific feedback questions ('is the tone right?') instead of open-ended ones.","w":[0.375,0.641,1.239,1.772,2.437,2.57,2.703,3.035,3.368,3.834,3.967,4.765],"p":[[1,"🎯","Ask specific questions","key"]]}],"ic":"✍️"},{"kind":"tip","label":"why","heading":null,"t0":5.804,"t1":12.33,"sents":[{"t0":5.804,"t1":12.33,"d":"Vague questions get vague answers, and specific ones give you clear direction so revisions take fewer rounds.","w":[5.833,6.157,6.806,7.066,7.391,7.78,7.975,8.559,8.884,9.144,9.338,9.663,10.247,10.507,11.091,11.416,11.805],"p":[[16,"🔁","Fewer revision rounds","key"]]}],"ic":"🚧"},{"kind":"tip","label":"how","heading":null,"t0":12.95,"t1":22.777,"sents":[{"t0":12.95,"t1":20.806,"d":"Send every draft with two or three targeted prompts, like whether the opening fits their audience or the call to action feels too strong.","w":[12.983,13.302,13.622,14.005,14.197,14.452,14.644,14.964,15.603,16.178,16.497,16.817,16.945,17.456,17.776,17.967,18.479,18.67,18.798,19.118,19.309,19.693,20.076,20.332]},{"t0":21.046,"t1":22.777,"d":"Ask for answers by a set date.","w":[21.071,21.284,21.498,21.818,22.032,22.192,22.405],"p":[[6,"📅","Reply deadline","do"]]}],"ic":"🤝"}]}
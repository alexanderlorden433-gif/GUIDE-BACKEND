{"id":"writing/9a9a6c58","th":"3e4065bd","dur":21.223,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.553,"sents":[{"t0":0.35,"t1":4.553,"d":"Separate drafting and editing into different sessions — don't edit while you write.","w":[0.378,0.774,1.228,1.397,1.794,2.077,2.53,2.927,3.097,3.437,3.72,4.003,4.173],"p":[[6,"📝","Draft then edit","key"]]}],"ic":"🎬"},{"kind":"tip","label":"why","heading":null,"t0":5.173,"t1":11.245,"sents":[{"t0":5.173,"t1":11.245,"d":"Editing as you go stalls your momentum, and you lose ideas while you're busy polishing a single sentence.","w":[5.193,5.639,5.766,5.957,6.211,6.656,6.847,7.483,7.674,7.865,8.183,8.628,8.946,9.137,9.455,10.027,10.218,10.663],"p":[[6,"🛑","Editing kills momentum","key"]]}],"ic":"🎬"},{"kind":"tip","label":"how","heading":null,"t0":11.865,"t1":20.673,"sents":[{"t0":11.865,"t1":16.454,"d":"Write your full first draft in one sitting without fixing anything, even typos.","w":[11.892,12.199,12.384,12.629,12.998,13.367,13.551,13.797,14.165,14.595,15.025,15.517,15.885],"p":[[7,"⏱️","One-sitting draft","do"]]},{"t0":16.694,"t1":20.673,"d":"Schedule the edit for a separate block later that day or the next morning.","w":[16.728,17.23,17.342,17.62,17.843,18.011,18.401,18.735,19.07,19.293,19.516,19.683,19.795,20.129]}],"ic":"🗓️"}]}
{"id":"writing/db8c0dfb","th":"178f1694","dur":21.471,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":5.118,"sents":[{"t0":0.35,"t1":5.118,"d":"Keep client communication in one place, not scattered across emails and texts.","w":[0.373,0.668,1.139,2.083,2.259,2.495,2.849,3.144,3.556,3.969,4.44,4.617],"p":[[5,"📌","One place only","key"]]}],"ic":"✉️"},{"kind":"tip","label":"why","heading":null,"t0":5.738,"t1":11.303,"sents":[{"t0":5.738,"t1":11.303,"d":"When feedback is spread across channels, you miss revision notes and can't prove what was actually approved.","w":[5.761,5.991,6.451,6.566,6.912,7.314,7.774,7.947,8.177,8.637,8.982,9.155,9.443,9.788,10.018,10.19,10.766],"p":[[12,"🧾","No approval proof","no"]]}],"ic":"🚧"},{"kind":"tip","label":"how","heading":null,"t0":11.923,"t1":20.921,"sents":[{"t0":11.923,"t1":15.881,"d":"Tell every new client that project feedback goes through email only.","w":[11.945,12.178,12.469,12.703,13.169,13.402,13.986,14.452,14.744,15.035,15.443]},{"t0":16.121,"t1":20.921,"d":"If they text you a change, copy it into the main email thread and confirm it there.","w":[16.146,16.272,16.461,16.839,17.029,17.218,17.722,18.101,18.227,18.542,18.668,18.983,19.425,19.74,19.929,20.434,20.56],"p":[[12,"🧵","Confirm in email","do"]]}],"ic":"✉️"}]}
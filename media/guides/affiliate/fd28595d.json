{"id": "affiliate/fd28595d", "th": "34dc9a21", "dur": 50.329, "scenes": [{"kind": "intro", "label": null, "heading": "Tell your audience you earn a commission", "t0": 0.35, "t1": 7.324, "sents": [{"t0": 0.35, "t1": 2.105, "d": "Tell your audience you earn a commission", "w": [0.35, 0.56, 0.769, 1.088, 1.291, 1.501, 1.691]}, {"t0": 2.345, "t1": 7.324, "d": "If you earn money from a recommendation, you must tell your audience. Here's how to do it right.", "w": [2.345, 2.558, 2.778, 3.005, 3.328, 3.555, 3.761, 4.523, 4.742, 4.969, 5.196, 5.423, 5.834, 6.164, 6.384, 6.597, 6.81, 7.023]}]}, {"kind": "point", "label": null, "heading": "It's the law", "t0": 7.944, "t1": 17.561, "sents": [{"t0": 7.944, "t1": 14.507, "d": "In the US, the Federal Trade Commission requires clear disclosure of any paid connection, and commissions count.", "w": [7.944, 8.199, 8.463, 8.846, 9.109, 9.621, 9.901, 10.438, 10.958, 11.238, 11.775, 12.03, 12.401, 12.673, 13.338, 13.601, 14.147], "p": [[9, "⚖️", "Required by law", "key"]]}, {"t0": 14.747, "t1": 17.561, "d": "Many countries have similar rules, so check yours.", "w": [14.747, 15.103, 15.499, 15.754, 16.235, 16.719, 16.959, 17.222]}], "ic": "⚖️"}, {"kind": "point", "label": null, "heading": "Use plain words", "t0": 18.181, "t1": 26.618, "sents": [{"t0": 18.181, "t1": 21.996, "d": "A line like, I earn a commission if you buy through my links, is clear.", "w": [18.181, 18.387, 18.613, 18.946, 19.152, 19.379, 19.584, 20.032, 20.244, 20.464, 20.684, 20.931, 21.144, 21.484, 21.696]}, {"t0": 22.236, "t1": 26.618, "d": "Something vague like, thanks to the brand, doesn't count, because it never says you're paid.", "w": [22.236, 22.691, 22.933, 23.277, 23.525, 23.745, 23.972, 24.323, 24.579, 24.93, 25.279, 25.498, 25.832, 26.066, 26.315], "p": [[1, "🙈", "Too vague", "no"]]}], "ic": "💬"}, {"kind": "point", "label": null, "heading": "Put it before the link", "t0": 27.238, "t1": 35.368, "sents": [{"t0": 27.238, "t1": 32.369, "d": "Place it near the top of a post, early in a caption, and say it out loud early in videos.", "w": [27.238, 27.474, 27.689, 27.918, 28.139, 28.361, 28.576, 28.784, 29.12, 29.447, 29.662, 29.87, 30.317, 30.539, 30.761, 30.976, 31.198, 31.427, 31.753, 31.968], "p": [[4, "⬆️", "Before the link", "do"]]}, {"t0": 32.609, "t1": 35.368, "d": "Use the platform's own disclosure settings as well.", "w": [32.609, 32.871, 33.133, 33.559, 33.821, 34.354, 34.764, 35.018]}], "ic": "👀"}, {"kind": "point", "label": null, "heading": "Follow each program's rules", "t0": 35.988, "t1": 42.977, "sents": [{"t0": 35.988, "t1": 40.481, "d": "Programs add their own rules, and Amazon doesn't allow its links in emails.", "w": [35.988, 36.403, 36.669, 36.951, 37.216, 37.735, 38.001, 38.507, 38.807, 39.197, 39.462, 39.745, 40.002]}, {"t0": 40.721, "t1": 42.977, "d": "Read the terms for every program you join.", "w": [40.721, 40.957, 41.187, 41.43, 41.66, 42.09, 42.442, 42.671], "p": [[2, "📜", "Read the terms", "do"]]}], "ic": "📜"}, {"kind": "point", "label": null, "heading": "Honesty builds trust", "t0": 43.597, "t1": 49.779, "sents": [{"t0": 43.597, "t1": 46.518, "d": "A short, friendly disclosure won't scare buyers off.", "w": [43.597, 43.855, 44.281, 44.712, 45.272, 45.565, 45.858, 46.159]}, {"t0": 46.758, "t1": 49.779, "d": "People who know where you stand are more likely to believe you.", "w": [46.758, 47.073, 47.282, 47.499, 47.722, 47.931, 48.154, 48.364, 48.58, 48.981, 49.184, 49.506], "p": [[10, "🤝", "Builds trust", "key"]]}], "ic": "🤝"}], "take": "Disclose plainly, before the first link, on every platform, every time."}
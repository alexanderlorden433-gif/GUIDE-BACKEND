{"id": "affiliate/b0a455b9", "th": "93c2063c", "dur": 48.065, "scenes": [{"kind": "intro", "label": null, "heading": "How affiliate marketing actually works", "t0": 0.35, "t1": 8.456, "sents": [{"t0": 0.35, "t1": 2.418, "d": "How affiliate marketing actually works", "w": [0.35, 0.607, 1.122, 1.638, 2.145]}, {"t0": 2.658, "t1": 8.456, "d": "Affiliate marketing means earning a cut when someone buys through your link. Here's who pays you, and why.", "w": [2.658, 3.165, 3.671, 3.94, 4.327, 4.564, 4.816, 5.077, 5.464, 5.725, 6.009, 6.27, 6.607, 6.987, 7.239, 7.5, 7.875, 8.127]}]}, {"kind": "point", "label": null, "heading": "One link, one commission", "t0": 9.076, "t1": 18.408, "sents": [{"t0": 9.076, "t1": 12.677, "d": "You recommend a product with a link that carries your personal ID.", "w": [9.076, 9.311, 9.783, 10.003, 10.363, 10.606, 10.826, 11.068, 11.311, 11.671, 11.914, 12.378], "p": [[11, "🔗", "Your tracking link", "key"]]}, {"t0": 12.917, "t1": 18.408, "d": "When someone clicks and buys within the program's cookie window, the company pays you a share of the sale.", "w": [12.917, 13.157, 13.515, 13.77, 14.003, 14.243, 14.594, 14.827, 15.199, 15.454, 15.917, 16.151, 16.603, 16.844, 17.077, 17.295, 17.543, 17.769, 18.002]}], "ic": "🔗"}, {"kind": "point", "label": null, "heading": "Why brands pay you", "t0": 19.028, "t1": 26.737, "sents": [{"t0": 19.028, "t1": 22.338, "d": "Ads cost money for every click, even when nobody buys.", "w": [19.028, 19.27, 19.521, 19.878, 20.12, 20.576, 20.952, 21.301, 21.551, 22.014]}, {"t0": 22.578, "t1": 26.737, "d": "You only get paid when a sale happens, so you're a sales team paid on results.", "w": [22.578, 22.795, 23.106, 23.322, 23.545, 23.768, 23.97, 24.281, 24.718, 24.927, 25.164, 25.366, 25.684, 25.907, 26.13, 26.34], "p": [[15, "🎯", "Paid on results", "key"]]}], "ic": "💡"}, {"kind": "point", "label": null, "heading": "Commissions vary by product", "t0": 27.357, "t1": 38.252, "sents": [{"t0": 27.357, "t1": 32.097, "d": "Physi
{"id": "coaching/59fb3237", "th": "ec626aff", "dur": 48.36, "scenes": [{"kind": "intro", "label": null, "heading": "Add a group program or self-paced course", "t0": 0.35, "t1": 9.351, "sents": [{"t0": 0.35, "t1": 2.569, "d": "Add a group program or self-paced course", "w": [0.35, 0.607, 0.848, 1.121, 1.515, 1.764, 2.288]}, {"t0": 2.809, "t1": 9.351, "d": "A group program breaks the link between hours worked and people served. Your framework is already the curriculum.", "w": [2.809, 3.057, 3.338, 3.743, 4.032, 4.296, 4.569, 4.974, 5.255, 5.652, 5.916, 6.313, 6.79, 7.063, 7.593, 7.848, 8.361, 8.625]}]}, {"kind": "point", "label": null, "heading": "Your calendar is the ceiling", "t0": 9.971, "t1": 18.786, "sents": [{"t0": 9.971, "t1": 15.112, "d": "One to one work is limited by the hours you can sit on calls without your quality dropping.", "w": [9.971, 10.212, 10.445, 10.686, 10.934, 11.168, 11.635, 11.868, 12.109, 12.365, 12.606, 12.847, 13.088, 13.321, 13.577, 13.946, 14.195, 14.662], "p": [[8, "⏳", "Hours are capped", "no"]]}, {"t0": 15.352, "t1": 18.786, "d": "A group moves several clients through the same process at once.", "w": [15.352, 15.59, 15.86, 16.233, 16.725, 17.011, 17.297, 17.551, 17.812, 18.202, 18.447]}], "ic": "⏳"}, {"kind": "point", "label": null, "heading": "Build it from your framework", "t0": 19.406, "t1": 28.465, "sents": [{"t0": 19.406, "t1": 24.369, "d": "The exercises, the questions you always ask and the templates you send are the material.", "w": [19.406, 19.65, 20.358, 20.603, 20.993, 21.237, 21.605, 21.849, 22.093, 22.338, 22.828, 23.072, 23.324, 23.569, 23.813]}, {"t0": 24.609, "t1": 28.465, "d": "Building a group version is mostly sequencing what already exists.", "w": [24.609, 25.029, 25.28, 25.565, 25.976, 26.236, 26.638, 27.184, 27.46, 27.981], "p": [[6, "🧩", "Reuse your method", "do"]]}], "ic": "🧩"}, {"kind": "point", "label": null, "heading": "Facilitation is the new skill", "t0": 29.085, "t1": 37.107, "sents": [{"t0": 29.085, "t1": 32.376, "d": "Running a room of eight is different from a private conversation.", "w": [29.085, 29.425, 29.633, 29.862, 30.078, 30.314, 30.529, 30.974, 31.203, 31.411, 31.752]}, {"t0": 32.616, "t1": 37.107, "d": "You are managing time, drawing out the quiet people, and using the group itself.", "w": [32.616, 32.86, 33.104, 33.585, 33.955, 34.329, 34.573, 34.817, 35.076, 35.561, 35.805, 36.163, 36.407, 36.667], "p": [[3, "🗣️", "Manage the room", "key"]]}], "ic": "🗣️"}, {"kind": "point", "label": null, "heading": "Test a small first cohort", "t0": 37.727, "t1": 47.81, "sents": [{"t0": 37.727, "t1": 42.418, "d": "Run six or eight people through it at a reduced price, as an explicit first round.", "w": [37.727, 37.969, 38.211, 38.446, 38.704, 39.068, 39.341, 39.575, 39.81, 40.037, 40.507, 40.882, 41.116, 41.351, 41.829, 42.087], "p": [[14, "🧪", "Small first round", "do"]]}, {"t0": 42.658, "t1": 47.81, "d": "Recording a course before testing it live is how people finish something nobody completes.", "w": [42.658, 43.167, 43.405, 43.684, 44.066, 44.456, 44.702, 44.964, 45.21, 45.464, 45.846, 46.228, 46.738, 47.223]}], "ic": "🧪"}], "take": "Your framework is the curriculum. Test it live with a small first cohort."}
{"id":"coaching/20e6d7ff","th":"70f2a20c","dur":20.295,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.284,"sents":[{"t0":0.35,"t1":4.284,"d":"Keep your intake questionnaire short enough that prospects actually complete it.","w":[0.377,0.63,0.781,1.134,1.739,2.042,2.294,2.496,3.05,3.555,4.008],"p":[[4,"✂️","Short intake form","key"]]}],"ic":"🧭"},{"kind":"tip","label":"why","heading":null,"t0":4.904,"t1":10.627,"sents":[{"t0":4.904,"t1":10.627,"d":"A long form feels like homework, and prospects who abandon it often never book the discovery call.","w":[4.929,5.113,5.357,5.723,6.09,6.395,6.945,7.128,7.8,8.044,8.533,8.655,8.96,9.266,9.51,9.632,10.243],"p":[[5,"📚","Feels like homework","key"]]}],"ic":"🧭"},{"kind":"tip","label":"how","heading":null,"t0":11.247,"t1":19.745,"sents":[{"t0":11.247,"t1":17.473,"d":"Cut it to five to seven questions that help you decide fit, and save deeper questions for the first session.","w":[11.272,11.521,11.646,11.833,12.145,12.332,12.706,13.329,13.578,13.89,14.077,14.513,14.762,14.949,15.261,15.635,16.258,16.507,16.632,17.006]},{"t0":17.713,"t1":19.745,"d":"Time yourself filling it out on your phone.","w":[17.736,17.994,18.459,18.769,18.872,19.078,19.233,19.388],"p":[[7,"📱","Test on phone","do"]]}],"ic":"🗓️"}]}
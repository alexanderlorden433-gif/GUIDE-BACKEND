{"id": "coaching/38c9e6cb", "th": "5d956d46", "dur": 26.571, "scenes": [{"kind": "intro", "label": null, "heading": "Keep a template agreement ready to send", "t0": 0.35, "t1": 7.529, "sents": [{"t0": 0.35, "t1": 2.39, "d": "Keep a template agreement ready to send", "w": [0.35, 0.584, 0.796, 1.15, 1.604, 1.937, 2.156]}, {"t0": 2.63, "t1": 7.529, "d": "The faster you go from yes to a first session, the less time a client has to second-guess.", "w": [2.63, 2.864, 3.215, 3.449, 3.675, 3.916, 4.15, 4.376, 4.595, 4.844, 5.316, 5.55, 5.791, 6.032, 6.251, 6.507, 6.741, 6.967]}]}, {"kind": "point", "label": null, "heading": "Delays cost momentum", "t0": 8.149, "t1": 14.366, "sents": [{"t0": 8.149, "t1": 12.485, "d": "Waiting days for paperwork gives a new client time to doubt the decision.", "w": [8.149, 8.554, 8.827, 9.091, 9.621, 10.009, 10.257, 10.521, 10.81, 11.083, 11.339, 11.62, 11.884], "p": [[10, "🤔", "Second thoughts", "no"]]}, {"t0": 12.725, "t1": 14.366, "d": "Their excitement starts to fade.", "w": [12.725, 12.978, 13.558, 13.819, 14.049]}], "ic": "⏳"}, {"kind": "point", "label": null, "heading": "One template, filled fast", "t0": 14.986, "t1": 26.021, "sents": [{"t0": 14.986, "t1": 22.88, "d": "Draft one agreement covering scope, sessions, payment, cancellations and confidentiality, and have a lawyer review it once.", "w": [14.986, 15.293, 15.581, 16.159, 16.728, 17.174, 17.766, 18.348, 19.08, 19.368, 20.493, 20.782, 21.079, 21.349, 21.783, 22.216, 22.495], "p": [[13, "⚖️", "Review once", "do"]]}, {"t0": 23.12, "t1": 26.021, "d": "Then fill in names and dates and send it the same day.", "w": [23.12, 23.345, 23.57, 23.781, 24.102, 24.32, 24.64, 24.858, 25.083, 25.294, 25.512, 25.737], "p": [[10, "⚡", "Same day", "do"]]}], "ic": "📄"}], "take": "Send the agreement the same day a client says yes."}
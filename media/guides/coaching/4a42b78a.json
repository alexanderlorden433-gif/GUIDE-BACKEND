{"id": "coaching/4a42b78a", "th": "efbb7bd9", "dur": 43.892, "scenes": [{"kind": "intro", "label": null, "heading": "Turn what you already do into a signature framework", "t0": 0.35, "t1": 9.049, "sents": [{"t0": 0.35, "t1": 3.091, "d": "Turn what you already do into a signature framework", "w": [0.35, 0.579, 0.808, 1.029, 1.46, 1.675, 1.994, 2.202, 2.646]}, {"t0": 3.331, "t1": 9.049, "d": "A named process makes your coaching easier to explain, sell and deliver the same way every time.", "w": [3.331, 3.566, 3.937, 4.323, 4.693, 4.953, 5.347, 5.725, 5.969, 6.477, 6.737, 6.988, 7.477, 7.729, 7.988, 8.24, 8.713]}]}, {"kind": "point", "label": null, "heading": "Vague sounds risky", "t0": 9.669, "t1": 18.413, "sents": [{"t0": 9.669, "t1": 13.919, "d": "We'll just talk it through can sound vague to someone deciding whether to hire you.", "w": [9.669, 9.925, 10.173, 10.421, 10.654, 10.926, 11.166, 11.422, 11.678, 11.911, 12.28, 12.755, 13.124, 13.358, 13.606], "p": [[7, "🌫️", "Too vague", "no"]]}, {"t0": 14.159, "t1": 18.413, "d": "A named, step by step process lets them picture the work before they pay.", "w": [14.159, 14.395, 14.886, 15.146, 15.389, 15.648, 16.034, 16.293, 16.553, 16.938, 17.189, 17.449, 17.826, 18.086]}], "ic": "🌫️"}, {"kind": "point", "label": null, "heading": "Start from what works", "t0": 19.033, "t1": 25.459, "sents": [{"t0": 19.033, "t1": 20.33, "d": "Don't invent something new.", "w": [19.033, 19.268, 19.6, 20.042]}, {"t0": 20.57, "t1": 25.459, "d": "Write down the steps you already take clients through, then group them into three to five stages.", "w": [20.57, 20.826, 21.075, 21.315, 21.571, 21.812, 22.28, 22.528, 22.799, 23.187, 23.436, 23.692, 23.94, 24.287, 24.543, 24.776, 25.024], "p": [[3, "📋", "Document it", "do"]]}], "ic": "📋"}, {"kind": "point", "label": null, "heading": "Name each stage simply", "t0": 26.079, "t1": 32.214, "sents": [{"t0": 26.079, "t1": 30.192, "d": "Give each stage a short, plain name and one line on what the client gets.", "w": [26.079, 26.341, 26.604, 26.874, 27.113, 27.506, 27.777, 28.039, 28.294, 28.548, 28.811, 29.057, 29.32, 29.574, 29.853], "p": [[5, "🏷️", "Keep it plain", "key"]]}, {"t0": 30.432, "t1": 32.214, "d": "Clarity beats a clever acronym.", "w": [30.432, 30.882, 31.129, 31.346, 31.694]}], "ic": "🏷️"}, {"kind": "point", "label": null, "heading": "It pays off later", "t0": 32.834, "t1": 43.342, "sents": [{"t0": 32.834, "t1": 40.175, "d": "A written framework makes it easier to create workbooks, delegate parts of delivery, or build a group program from the same method.", "w": [32.834, 33.065, 33.442, 33.934, 34.296, 34.534, 34.903, 35.141, 35.41, 35.922, 36.407, 36.668, 36.906, 37.61, 37.848, 38.109, 38.34, 38.601, 38.978, 39.232, 39.477, 39.731], "p": [[8, "📚", "Reusable method", "key"]]}, {"t0": 40.415, "t1": 43.342, "d": "Expect to refine it as you work with more clients.", "w": [40.415, 40.799, 41.047, 41.432, 41.68, 41.928, 42.184, 42.448, 42.712, 42.976]}], "ic": "📈"}], "take": "Name and structure what already works, then refine it as you go."}
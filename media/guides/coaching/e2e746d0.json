{"id":"coaching/e2e746d0","th":"155c14e8","dur":21.462,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":5.051,"sents":[{"t0":0.35,"t1":5.051,"d":"End every session with specific, written action items, not just verbal agreement.","w":[0.372,0.623,0.937,1.313,1.501,2.066,2.38,2.757,3.196,3.51,3.886,4.325],"p":[[5,"📝","Written action items","key"]]}],"ic":"📝"},{"kind":"tip","label":"why","heading":null,"t0":5.671,"t1":12.579,"sents":[{"t0":5.671,"t1":12.579,"d":"Clients forget spoken promises within days, and without clear tasks, progress stalls and they start doubting the coaching.","w":[5.69,6.241,6.608,7.097,7.709,8.076,8.382,8.565,8.994,9.3,9.667,10.217,10.645,10.829,11.012,11.441,11.869,11.991],"p":[[1,"🧠","Clients forget fast","key"]]}],"ic":"🤝"},{"kind":"tip","label":"how","heading":null,"t0":13.199,"t1":20.912,"sents":[{"t0":13.199,"t1":18.117,"d":"Save the last five minutes of each session to agree on two or three tasks with deadlines.","w":[13.238,13.543,13.664,13.968,14.273,14.698,14.82,15.124,15.489,15.671,16.036,16.219,16.462,16.645,16.949,17.314,17.496]},{"t0":18.357,"t1":20.912,"d":"Send them in a short recap message the same day.","w":[18.396,18.665,18.88,19.041,19.202,19.524,19.847,20.223,20.33,20.599],"p":[[5,"📨","Same-day recap","do"]]}],"ic":"🗓️"}]}
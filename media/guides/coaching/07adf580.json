{"id": "coaching/07adf580", "th": "26e33bd1", "dur": 49.002, "scenes": [{"kind": "intro", "label": null, "heading": "Get your first clients without testimonials", "t0": 0.35, "t1": 8.868, "sents": [{"t0": 0.35, "t1": 2.61, "d": "Get your first clients without testimonials", "w": [0.35, 0.624, 0.906, 1.197, 1.505, 1.924]}, {"t0": 2.85, "t1": 8.868, "d": "The first two or three clients are the hardest, because nobody has proof yet. Here are three ways to get them.", "w": [2.85, 3.096, 3.357, 3.603, 3.841, 4.103, 4.38, 4.625, 4.871, 5.367, 5.745, 6.214, 6.46, 6.721, 7.042, 7.295, 7.541, 7.802, 8.056, 8.294, 8.54]}]}, {"kind": "point", "label": null, "heading": "Offer a few pilot spots", "t0": 9.488, "t1": 20.825, "sents": [{"t0": 9.488, "t1": 17.033, "d": "Offer a small number of places at a reduced rate, say three, in exchange for honest feedback and a detailed testimonial.", "w": [9.488, 9.875, 10.122, 10.402, 10.798, 11.053, 11.449, 11.704, 11.951, 12.462, 12.861, 13.125, 13.532, 13.787, 14.2, 14.463, 14.859, 15.271, 15.535, 15.781, 16.301], "p": [[20, "💬", "Trade for proof", "do"]]}, {"t0": 17.273, "t1": 20.825, "d": "Put a date on it so it reads as a launch, not a permanent discount.", "w": [17.273, 17.479, 17.673, 17.886, 18.086, 18.286, 18.486, 18.686, 18.906, 19.106, 19.299, 19.625, 19.832, 20.025, 20.439]}], "ic": "🎟️"}, {"kind": "point", "label": null, "heading": "Tell your network specifically", "t0": 21.445, "t1": 30.17, "sents": [{"t0": 21.445, "t1": 24.927, "d": "Saying you are coaching now gives nobody anything to act on.", "w": [21.445, 21.713, 21.957, 22.201, 22.584, 22.828, 23.187, 23.654, 24.136, 24.372, 24.616]}, {"t0": 25.167, "t1": 30.17, "d": "Name who you help, the result, and what you are looking for right now, then ask for an introduction.", "w": [25.167, 25.387, 25.6, 25.814, 26.137, 26.35, 26.774, 26.987, 27.207, 27.421, 27.634, 27.961, 28.174, 28.401, 28.718, 28.938, 29.151, 29.365, 29.571], "p": [[18, "🤝", "Ask for an intro", "do"]]}], "ic": "📣"}, {"kind": "point", "label": null, "heading": "Give one structured session", "t0": 30.79, "t1": 41.749, "sents": [{"t0": 30.79, "t1": 37.501, "d": "Offer one free or low cost session to a few people who fit your niche, not an open ended free relationship.", "w": [30.79, 31.174, 31.434, 31.703, 31.956, 32.216, 32.485, 32.885, 33.138, 33.382, 33.643, 34.034, 34.295, 34.555, 34.824, 35.228, 35.488, 35.741, 36.116, 36.499, 36.768], "p": [[6, "🎯", "One session only", "key"]]}, {"t0": 37.741, "t1": 41.749, "d": "Many people only understand coaching once they have had an hour of it.", "w": [37.741, 38.094, 38.463, 38.817, 39.317, 39.701, 39.955, 40.208, 40.462, 40.707, 40.945, 41.198, 41.436]}], "ic": "🎯"}, {"kind": "point", "label": null, "heading": "Then charge your full price", "t0": 42.369, "t1": 48.452, "sents": [{"t0": 42.369, "t1": 44.98, "d": "When the pilot spots are gone, quote your full rate.", "w": [42.369, 42.602, 42.828, 43.161, 43.401, 43.628, 43.97, 44.211, 44.444, 44.678], "p": [[8, "💵", "Full price next", "do"]]}, {"t0": 45.22, "t1": 48.452, "d": "And ask for the testimonial while the result is still fresh.", "w": [45.22, 45.453, 45.686, 45.92, 46.153, 46.731, 47.074, 47.308, 47.658, 47.884, 48.133]}], "ic": "💵"}], "take": "Trade a few pilot spots for proof, and tell your network exactly who you help."}
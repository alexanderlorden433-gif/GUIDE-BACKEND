{"id": "coaching/67f4f690", "th": "6ee471a7", "dur": 47.049, "scenes": [{"kind": "intro", "label": null, "heading": "Handle scope creep with change orders", "t0": 0.35, "t1": 9.009, "sents": [{"t0": 0.35, "t1": 2.329, "d": "Handle scope creep with change orders", "w": [0.35, 0.76, 1.05, 1.34, 1.621, 1.919]}, {"t0": 2.569, "t1": 9.009, "d": "Consulting work expands quietly because nothing about it is physical. Scope in writing is what stops it.", "w": [2.569, 3.144, 3.436, 3.869, 4.303, 4.736, 5.17, 5.585, 5.859, 6.133, 6.776, 7.076, 7.35, 7.784, 8.057, 8.349, 8.649]}]}, {"kind": "point", "label": null, "heading": "Why consulting creeps", "t0": 9.629, "t1": 18.632, "sents": [{"t0": 9.629, "t1": 13.353, "d": "One quick question becomes a second review, then a deck for the board.", "w": [9.629, 9.856, 10.098, 10.455, 10.897, 11.11, 11.452, 11.904, 12.139, 12.352, 12.587, 12.814, 13.042], "p": [[2, "🫠", "Quick question", "no"]]}, {"t0": 13.593, "t1": 18.632, "d": "Nobody notices extra hours the way they would notice an extra crate on a delivery.", "w": [13.593, 14.073, 14.56, 14.929, 15.196, 15.447, 15.698, 15.957, 16.224, 16.601, 16.844, 17.214, 17.481, 17.724, 17.959]}], "ic": "🫠"}, {"kind": "point", "label": null, "heading": "Write what is in and out", "t0": 19.252, "t1": 27.904, "sents": [{"t0": 19.252, "t1": 22.911, "d": "List the deliverables, the rounds of feedback and the meetings included.", "w": [19.252, 19.49, 19.72, 20.502, 20.732, 20.984, 21.207, 21.567, 21.797, 22.027, 22.387]}, {"t0": 23.151, "t1": 27.904, "d": "Then name a few things that are out of scope, like implementation or training the team.", "w": [23.151, 23.402, 23.654, 23.882, 24.125, 24.392, 24.643, 24.886, 25.13, 25.366, 25.742, 25.994, 26.719, 26.954, 27.336, 27.579], "p": [[7, "📄", "Out of scope list", "do"]]}], "ic": "📄"}, {"kind": "point", "label": null, "heading": "Quote it, do not refuse", "t0": 28.524, "t1": 37.085, "sents": [{"t0": 28.524, "t1": 32.22, "d": "When a request falls outside the agreement, treat it as a change order.", "w": [28.524, 28.757, 28.968, 29.314, 29.554, 29.899, 30.125, 30.686, 30.926, 31.144, 31.362, 31.574, 31.82], "p": [[12, "🧾", "Change order", "key"]]}, {"t0": 32.46, "t1": 37.085, "d": "Say you are happy to take it on, and that it would be a separate piece of work with its own fee.", "w": [32.46, 32.651, 32.842, 33.033, 33.314, 33.498, 33.695, 33.88, 34.157, 34.348, 34.545, 34.73, 34.933, 35.118, 35.297, 35.673, 35.876, 36.061, 36.258, 36.455, 36.645, 36.836]}], "ic": "🧾"}, {"kind": "point", "label": null, "heading": "Watch the small favors", "t0": 37.705, "t1": 46.499, "sents": [{"t0": 37.705, "t1": 42.053, "d": "A fifteen minute favor three times a week is a day a month you never invoiced.", "w": [37.705, 37.913, 38.253, 38.587, 38.913, 39.149, 39.475, 39.683, 39.912, 40.127, 40.334, 40.556, 40.764, 41.0, 41.222, 41.548]}, {"t0": 42.293, "t1": 46.499, "d": "If little extras keep building, bundle them into a priced monthly add on.", "w": [42.293, 42.529, 42.895, 43.261, 43.512, 44.011, 44.377, 44.628, 44.979, 45.207, 45.573, 45.946, 46.19], "p": [[5, "⏳", "Bundle the extras", "do"]]}], "ic": "⏳"}], "take": "Define what's out of scope, then price extras as change orders."}
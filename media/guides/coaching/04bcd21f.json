{"id": "coaching/04bcd21f", "th": "153bbeb1", "dur": 23.339, "scenes": [{"kind": "intro", "label": null, "heading": "Ask for the testimonial the day of the win", "t0": 0.35, "t1": 6.315, "sents": [{"t0": 0.35, "t1": 2.534, "d": "Ask for the testimonial the day of the win", "w": [0.35, 0.559, 0.768, 0.977, 1.495, 1.704, 1.913, 2.116, 2.325]}, {"t0": 2.774, "t1": 6.315, "d": "Ask for a testimonial the day a client wins, not months later.", "w": [2.774, 3.013, 3.252, 3.475, 4.066, 4.305, 4.544, 4.767, 5.029, 5.391, 5.63, 5.891]}]}, {"kind": "point", "label": null, "heading": "Fresh words are specific", "t0": 6.935, "t1": 13.473, "sents": [{"t0": 6.935, "t1": 10.339, "d": "Months later you get a vague line about being great to work with.", "w": [6.935, 7.191, 7.536, 7.77, 8.004, 8.224, 8.473, 8.715, 9.059, 9.308, 9.558, 9.784, 10.026], "p": [[5, "🗣️", "Vague praise", "no"]]}, {"t0": 10.579, "t1": 13.473, "d": "On the day, you get the detail that makes it believable.", "w": [10.579, 10.777, 10.981, 11.284, 11.488, 11.692, 11.896, 12.203, 12.414, 12.714, 12.912]}], "ic": "🗣️"}, {"kind": "point", "label": null, "heading": "Make it easy to write", "t0": 14.093, "t1": 22.789, "sents": [{"t0": 14.093, "t1": 18.268, "d": "Congratulate them, then ask for two or three sentences about what changed.", "w": [14.093, 14.73, 15.115, 15.377, 15.631, 15.885, 16.14, 16.386, 16.656, 17.165, 17.539, 17.801]}, {"t0": 18.508, "t1": 22.789, "d": "Send three prompts and offer to tidy the wording and send it back for approval.", "w": [18.508, 18.754, 19.008, 19.277, 19.515, 19.866, 20.097, 20.441, 20.679, 21.045, 21.284, 21.53, 21.761, 22.007, 22.246], "p": [[2, "✍️", "Send prompts", "do"]]}], "ic": "✍️"}], "take": "Ask the day of the win, and send prompts to make writing easy."}
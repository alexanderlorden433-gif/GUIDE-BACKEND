{"id":"ugc/bb2fcb60","th":"df6f3362","dur":23.242,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":6.458,"sents":[{"t0":0.35,"t1":6.458,"d":"Hook the viewer in the first two seconds or they scroll past — open with a bold claim, question, or visual.","w":[0.403,0.641,0.76,1.118,1.297,1.416,1.774,2.012,2.489,2.668,2.847,3.264,3.562,3.741,4.099,4.277,4.456,4.814,5.172,5.708,5.887],"p":[[7,"🎣","Two-second hook","key"]]}],"ic":"🎬"},{"kind":"tip","label":"why","heading":null,"t0":7.078,"t1":12.532,"sents":[{"t0":7.078,"t1":12.532,"d":"Brands judge your videos by watch time, and a slow start means the product never gets seen.","w":[7.101,7.52,7.879,8.059,8.538,8.778,9.137,9.437,9.616,9.796,10.096,10.515,10.874,10.994,11.533,11.833,12.132],"p":[[5,"⏱️","Watch time matters","key"]]}],"ic":"🗓️"},{"kind":"tip","label":"how","heading":null,"t0":13.152,"t1":22.692,"sents":[{"t0":13.152,"t1":17.504,"d":"Write three possible opening lines for every script before filming the rest.","w":[13.18,13.483,13.786,14.331,14.816,15.18,15.422,15.725,16.15,16.574,16.998,17.12],"p":[[1,"✍️","Write three openers","do"]]},{"t0":17.744,"t1":22.692,"d":"Start mid-action or with the product's result on screen, not with a greeting or intro.","w":[17.777,18.192,18.784,18.962,19.139,19.258,19.85,20.264,20.442,20.856,21.152,21.33,21.508,21.981,22.159]}],"ic":"🎬"}]}
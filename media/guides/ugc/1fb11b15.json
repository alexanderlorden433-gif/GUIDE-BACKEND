{"id":"ugc/1fb11b15","th":"696e0af8","dur":22.577,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":5.045,"sents":[{"t0":0.35,"t1":5.045,"d":"Always shoot more takes than you think you need — you can't reshoot once the setup is gone.","w":[0.374,0.831,1.117,1.403,1.746,1.918,2.089,2.375,2.547,2.832,3.004,3.175,3.461,3.862,4.147,4.262,4.605,4.719],"p":[[12,"🎬","Shoot extra takes","do"]]}],"ic":"📸"},{"kind":"tip","label":"why","heading":null,"t0":5.665,"t1":12.519,"sents":[{"t0":5.665,"t1":12.519,"d":"Brands often ask for a different line read or angle after review, and extra takes let you deliver without refilming.","w":[5.695,6.131,6.442,6.69,6.939,7.126,7.623,7.934,8.245,8.432,8.805,9.116,9.551,9.738,10.173,10.546,10.795,10.981,11.417,11.852],"p":[[19,"🔄","No refilming","key"]]}],"ic":"⭐"},{"kind":"tip","label":"how","heading":null,"t0":13.139,"t1":22.027,"sents":[{"t0":13.139,"t1":17.087,"d":"Film every line three ways, varying energy, pacing and framing.","w":[13.212,13.543,13.873,14.204,14.535,14.866,15.329,15.792,16.255,16.453],"p":[[3,"🎙️","Three ways each","do"]]},{"t0":17.327,"t1":22.027,"d":"Grab a few extra product close-ups before you pack up, so editing has options.","w":[17.352,17.644,17.819,18.11,18.518,19.043,19.625,20.033,20.208,20.441,20.616,20.849,21.257,21.49]}],"ic":"🎬"}]}
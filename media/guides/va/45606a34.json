{"id":"va/45606a34","th":"76506d5c","dur":22.414,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.382,"sents":[{"t0":0.35,"t1":4.382,"d":"Keep a clear escalation process for urgent, time-sensitive requests.","w":[0.364,0.649,0.82,1.106,1.792,2.249,2.477,2.934,3.791],"p":[[3,"🚨","Escalation process","do"]]}],"ic":"🗓️"},{"kind":"tip","label":"why","heading":null,"t0":5.002,"t1":12.142,"sents":[{"t0":5.002,"t1":12.142,"d":"Without agreed rules, every request feels urgent, and true emergencies can get lost in the inbox with everything else.","w":[5.027,5.479,5.931,6.319,6.642,7.159,7.546,8.063,8.257,8.58,9.355,9.614,9.872,10.195,10.389,10.518,11.035,11.229,11.811],"p":[[12,"📥","Emergencies get lost","no"]]}],"ic":"✉️"},{"kind":"tip","label":"how","heading":null,"t0":12.761,"t1":21.864,"sents":[{"t0":12.761,"t1":19.479,"d":"Agree with each client on what counts as urgent and how to flag it, like a phone call or a specific subject line.","w":[12.784,13.144,13.325,13.625,14.105,14.285,14.525,14.945,15.065,15.545,15.725,15.966,16.146,16.446,16.566,16.866,17.046,17.346,17.646,17.826,18.006,18.547,19.087],"p":[[12,"🚩","Define urgent + flag","do"]]},{"t0":19.719,"t1":21.864,"d":"Write it down and share it during onboarding.","w":[19.749,20.007,20.11,20.368,20.523,20.729,20.833,21.194]}],"ic":"🤝"}]}
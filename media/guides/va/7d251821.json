{"id":"va/7d251821","th":"306269d1","dur":21.701,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.165,"sents":[{"t0":0.35,"t1":4.165,"d":"Keep your own calendar blocked for deep work, not just client meetings.","w":[0.372,0.646,0.81,1.029,1.467,1.85,2.069,2.343,2.617,2.89,3.219,3.657],"p":[[4,"🎧","Block deep work","do"]]}],"ic":"🗓️"},{"kind":"tip","label":"why","heading":null,"t0":4.785,"t1":11.825,"sents":[{"t0":4.785,"t1":11.825,"d":"If clients can grab any open slot, your focused tasks like reports and inbox cleanups keep getting pushed to evenings.","w":[4.808,4.93,5.478,5.722,6.026,6.27,6.636,7.001,7.184,7.671,8.037,8.342,8.89,9.073,9.56,10.108,10.413,10.779,11.083,11.266],"p":[[19,"🌙","Pushed to evenings","no"]]}],"ic":"✉️"},{"kind":"tip","label":"how","heading":null,"t0":12.445,"t1":21.151,"sents":[{"t0":12.445,"t1":16.687,"d":"Block two or three focus sessions a week on your calendar and mark them busy.","w":[12.473,12.816,13.045,13.216,13.502,13.902,14.302,14.473,14.759,14.93,15.101,15.558,15.73,16.073,16.301],"p":[[14,"🗓️","Mark them busy","do"]]},{"t0":16.927,"t1":21.151,"d":"Treat them like client meetings and only move them for real emergencies.","w":[16.945,17.294,17.527,17.817,18.283,18.748,18.922,19.271,19.562,19.794,20.027,20.376]}],"ic":"🗓️"}]}
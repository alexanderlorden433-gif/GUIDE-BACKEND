{"id":"design/d797b7a9","th":"247bc04a","dur":21.934,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":4.894,"sents":[{"t0":0.35,"t1":4.894,"d":"Ask clients for their brand's competitors before starting, not just their preferences.","w":[0.37,0.595,1.102,1.327,1.496,1.89,2.509,2.903,3.409,3.691,4.028,4.197],"p":[[5,"🏁","Ask about competitors","key"]]}],"ic":"🤝"},{"kind":"tip","label":"why","heading":null,"t0":5.514,"t1":11.908,"sents":[{"t0":5.514,"t1":11.908,"d":"A logo that looks great but resembles a rival's will confuse customers and get sent back for a full redo.","w":[5.54,5.717,6.131,6.367,6.662,7.017,7.253,7.844,8.021,8.494,8.73,9.262,9.794,9.971,10.207,10.503,10.739,10.975,11.153,11.389],"p":[[6,"👯","Avoid lookalike logos","key"]]}],"ic":"🤝"},{"kind":"tip","label":"how","heading":null,"t0":12.528,"t1":21.384,"sents":[{"t0":12.528,"t1":16.642,"d":"Add a question to your intake form asking for three to five competitors.","w":[12.552,12.729,12.906,13.437,13.615,13.792,14.205,14.559,14.914,15.15,15.445,15.622,15.918]},{"t0":16.882,"t1":21.384,"d":"Look at their colors, type and logos before sketching so your work stands apart.","w":[16.909,17.148,17.267,17.445,17.803,18.101,18.279,18.756,19.173,19.65,19.888,20.067,20.364,20.781],"p":[[13,"🎨","Stand apart","do"]]}],"ic":"🎨"}]}
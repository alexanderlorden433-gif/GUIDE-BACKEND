{"id":"design/6b9ecdfb","th":"1535dba0","dur":24.753,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":6.21,"sents":[{"t0":0.35,"t1":6.21,"d":"Keep client communication in one place (email or a project tool), not scattered across apps.","w":[0.379,0.69,1.186,2.178,2.364,2.613,2.985,3.419,3.605,3.791,4.411,4.722,5.032,5.466,5.9],"p":[[5,"📍","One channel only","key"]]}],"ic":"✉️"},{"kind":"tip","label":"why","heading":null,"t0":6.83,"t1":15.002,"sents":[{"t0":6.83,"t1":15.002,"d":"Feedback buried in texts and direct messages gets missed, and missed feedback means extra revision rounds and frustrated clients.","w":[6.898,7.428,7.826,8.025,8.489,8.688,9.152,9.749,10.081,10.412,10.611,10.943,11.473,11.871,12.335,12.865,13.33,13.528,14.324],"p":[[8,"🙈","Feedback gets buried","key"]]}],"ic":"🚧"},{"kind":"tip","label":"how","heading":null,"t0":15.622,"t1":24.203,"sents":[{"t0":15.622,"t1":19.293,"d":"Tell each client at kickoff where all feedback and files should go.","w":[15.643,15.889,16.197,16.69,16.813,17.183,17.429,17.675,18.168,18.353,18.722,18.969],"p":[[4,"🚀","Tell at kickoff","do"]]},{"t0":19.533,"t1":24.203,"d":"If something arrives elsewhere, copy it over yourself and reply in that one channel.","w":[19.556,19.681,20.119,20.557,20.995,21.371,21.496,21.809,22.372,22.56,22.998,23.186,23.436,23.687]}],"ic":"🤝"}]}
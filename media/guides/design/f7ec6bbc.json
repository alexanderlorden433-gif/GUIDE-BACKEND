{"id":"design/f7ec6bbc","th":"e5f57283","dur":23.422,"scenes":[{"kind":"tip","label":null,"heading":null,"t0":0.35,"t1":5.157,"sents":[{"t0":0.35,"t1":5.157,"d":"Ask for feedback in specific terms ('what's not working and why'), not just 'thoughts?'","w":[0.374,0.624,0.875,1.375,1.563,2.127,2.502,2.815,3.128,3.566,3.754,4.005,4.318,4.693],"p":[[4,"🎯","Ask specific questions","key"]]}],"ic":"📝"},{"kind":"tip","label":"why","heading":null,"t0":5.777,"t1":13.093,"sents":[{"t0":5.777,"t1":13.093,"d":"Vague reactions lead to guesswork revisions, extra rounds and designs that drift further from what the client actually needs.","w":[5.804,6.12,6.689,7.005,7.195,7.701,8.27,8.712,9.155,9.345,9.851,10.104,10.483,10.862,11.115,11.368,11.495,12.001,12.633],"p":[[4,"🎲","Vague means guesswork","no"]]}],"ic":"🚧"},{"kind":"tip","label":"how","heading":null,"t0":13.713,"t1":22.872,"sents":[{"t0":13.713,"t1":21.003,"d":"When you share a draft, include two or three targeted prompts, like which element feels off-brand and what it should feel like instead.","w":[13.736,13.97,14.145,14.378,14.553,14.904,15.37,15.604,15.779,16.071,16.654,17.18,17.471,17.763,18.23,18.58,19.106,19.281,19.514,19.631,19.864,20.156,20.448]},{"t0":21.243,"t1":22.872,"d":"Tie each one back to the brief.","w":[21.266,21.479,21.746,21.959,22.172,22.332,22.438],"p":[[6,"📎","Tie to brief","do"]]}],"ic":"🎨"}]}